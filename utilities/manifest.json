{
  "nodes": [
    {
      "type": "detect",
      "label": "按页切题",
      "desc": "识别每道题的作答区域并裁剪（题号 + 页码 + 坐标）",
      "inputs": [],
      "outputs": ["questions"],
      "params": [
        {"key": "batch", "label": "每批页数（1 最稳）", "default": 1},
        {"key": "extra", "label": "补充提示词", "default": ""}
      ]
    },
    {
      "type": "match",
      "label": "定位答案",
      "desc": "在教师版答案中定位该题的标准答案片段",
      "inputs": ["questions"],
      "outputs": ["answers"],
      "params": [
        {"key": "window", "label": "答案窗口字数", "default": 400}
      ]
    },
    {
      "type": "grade",
      "label": "逐题判分",
      "desc": "逐题对照标准答案判定（对/半对/错/无法判定），输出 OCR 与评语；未配置满分时不编造分数",
      "inputs": ["questions", "answers"],
      "outputs": ["graded"],
      "params": [
        {"key": "max_tokens", "label": "输出上限（思考模型需 ≥6000）", "default": 12000},
        {"key": "max_score", "label": "每题满分（0 = 只判定不给分）", "default": 0},
        {"key": "workers", "label": "并发题数", "default": 4},
        {"key": "extra", "label": "补充提示词", "default": ""}
      ]
    }
  ]
}
